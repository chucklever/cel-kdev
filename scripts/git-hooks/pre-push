#!/bin/bash
# pre-push: enforce plugin version bump when plugin packaging changes.
# Claude Code and Codex cache installed plugin contents, so any push
# that touches plugin contents must carry a fresh version.

set -e

ZERO=0000000000000000000000000000000000000000
PLUGIN=plugin/cel-kdev/.claude-plugin/plugin.json
ROOT_PLUGIN=.claude-plugin/plugin.json
CODEX=plugin/cel-kdev/.codex-plugin/plugin.json

fail() {
    echo "pre-push: $*" >&2
    exit 1
}

if ! command -v jq >/dev/null 2>&1; then
    fail "jq is required but not installed"
fi

local_plugin=$(jq -r '.version' "$PLUGIN")
local_root=$(jq -r '.version' "$ROOT_PLUGIN")
local_codex=$(jq -r '.version' "$CODEX")

if [ "$local_plugin" != "$local_codex" ] || [ "$local_plugin" != "$local_root" ]; then
    fail "manifest version mismatch ($PLUGIN=$local_plugin, $ROOT_PLUGIN=$local_root, $CODEX=$local_codex); run scripts/bump-version.sh"
fi

while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    [ "$remote_sha" = "$ZERO" ] && continue

    if git diff --quiet "$remote_sha" "$local_sha" -- .agents/plugins .claude-plugin plugin; then
        continue
    fi

    old_plugin=$(git show "$remote_sha:$PLUGIN" 2>/dev/null | jq -r '.version' 2>/dev/null || true)
    if [ -z "$old_plugin" ] || [ "$old_plugin" = "null" ]; then
        continue
    fi

    if [ "$old_plugin" = "$local_plugin" ]; then
        fail "plugin contents changed but version is still $local_plugin; run scripts/bump-version.sh <new>"
    fi
done

exit 0
